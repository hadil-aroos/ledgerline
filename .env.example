# Copy to .env and edit. .env is never committed.
BOOKS_COMPANY=My Company
BOOKS_CURRENCY=USD
# First month of the fiscal year (1 = January, 4 = April)
BOOKS_FY_START_MONTH=1
# Accounts pre-filled on the New item form (full names from your chart of accounts)
BOOKS_DEFAULT_INCOME_ACCOUNT=
BOOKS_DEFAULT_COGS_ACCOUNT=
# Set to 1 when the app is served over HTTPS
BOOKS_HTTPS=0
